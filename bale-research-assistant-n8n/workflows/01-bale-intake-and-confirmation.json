    {
      "parameters": {
        "jsCode": "\nconst agentData = $input.first()?.json ?? {};\n\n// اطلاعات پیام کاربر از نود ورودی نرمال‌شده\nconst inputData = $('Normalized Input').first()?.json ?? {};\n\nconst chatId = inputData.chat_id;\nconst userText = String(inputData.userText ?? '').trim();\n\nif (chatId === undefined || chatId === null || String(chatId).trim() === '') {\n  throw new Error(\n    'chat_id خالی است. خروجی نود «Normalized Input» را بررسی کن.'\n  );\n}\n\nif (!userText) {\n  throw new Error(\n    'متن پیام کاربر خالی است. مقدار userText را در نود «Normalized Input» بررسی کن.'\n  );\n}\n\n// استخراج خروجی مدل\nlet result = agentData.output ?? agentData;\n\nfor (let i = 0; i < 5; i++) {\n  if (typeof result === 'string') {\n    try {\n      result = JSON.parse(result);\n      continue;\n    } catch {\n      break;\n    }\n  }\n\n  if (result && typeof result === 'object' && !Array.isArray(result)) {\n    if (result.output !== undefined) {\n      result = result.output;\n      continue;\n    }\n\n    if (\n      result.result !== undefined &&\n      result.topic === undefined &&\n      result.main_question === undefined\n    ) {\n      result = result.result;\n      continue;\n    }\n  }\n\n  break;\n}\n\nif (!result || typeof result !== 'object' || Array.isArray(result)) {\n  result = {};\n}\n\nconst topic =\n  String(result.topic ?? '').trim() ||\n  String(result.main_question ?? '').trim() ||\n  userText;\n\nconst brief = {\n  topic,\n  main_question:\n    String(result.main_question ?? '').trim() || topic,\n  situation: String(result.situation ?? '').trim(),\n  key_concepts: Array.isArray(result.key_concepts)\n    ? result.key_concepts\n    : [],\n  related_domains: Array.isArray(result.related_domains)\n    ? result.related_domains\n    : [],\n  date_range: String(result.date_range ?? '').trim(),\n  is_followup:\n    result.is_followup === true ||\n    result.is_followup === 'true',\n  output_type: String(result.output_type ?? '').trim()\n};\n\n// Session قبلی\nconst priorSession =\n  $('Get Session').first()?.json ?? {};\n\nconst isFollowup = brief.is_followup;\n\nconst researchId =\n  isFollowup &&\n  priorSession.state === 'completed' &&\n  priorSession.research_id\n    ? priorSession.research_id\n    : `r_${Date.now()}_${String(chatId)}`;\n\nconst lines = [\n  '🔎 برداشت من از درخواست شما:',\n  '',\n  `موضوع: ${brief.topic}`,\n  `سؤال اصلی: ${brief.main_question}`\n];\n\nif (brief.situation) {\n  lines.push(`زمینه/موقعیت: ${brief.situation}`);\n}\n\nif (brief.key_concepts.length) {\n  lines.push(`مفاهیم کلیدی: ${brief.key_concepts.join('، ')}`);\n}\n\nif (brief.related_domains.length) {\n  lines.push(`حوزه‌های مرتبط: ${brief.related_domains.join('، ')}`);\n}\n\nif (brief.date_range) {\n  lines.push(`بازه زمانی منابع: ${brief.date_range}`);\n}\n\nif (brief.output_type) {\n  lines.push(`نوع خروجی: ${brief.output_type}`);\n}\n\nlines.push(\n  '',\n  'اگر این برداشت درست است، روی دکمه زیر بزنید تا تحقیق شروع شود.',\n  'اگر نیاز به اصلاح دارد، توضیح دقیق‌تری بفرستید.'\n);\n\nreturn [{\n  json: {\n    chat_id: String(chatId),\n    research_id: researchId,\n    topic: brief.topic,\n    brief_json: JSON.stringify(brief),\n    confirm_text: lines.join('\\n')\n  }\n}];\n"
      },
